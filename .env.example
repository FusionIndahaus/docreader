# Основные настройки сервера
SERVER_PORT=8081
MAX_FILE_SIZE_MB=50
MAX_RESPONSES=20

# OpenRouter API Configuration (для обработки документов через AI)
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.0-flash-001

# Site information для OpenRouter
SITE_URL=https://your-site.com
SITE_TITLE=Your Site Title

# Service-to-Service Authentication (для связи с backend-gateway)
DOCREADER_API_KEY=your-secure-api-key-here

# Database Configuration
DATABASE_URL=postgres://appuser:apppass@localhost:5432/appdb?sslmode=disable

# Session Security
SESSION_SECRET=your-secret-key-change-in-production

# Admin Account
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:8081
CORS_ALLOW_CREDENTIALS=true
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# N8N интеграция
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/your-webhook-id

# Пути к файлам
STATIC_DIR=static
ONEC_CONFIG_PATH=config/onec.json

# 1С интеграция (базовые настройки)
ONEC_ENABLED=false
ONEC_AUTO_SEND=false
ONEC_BASE_URL=http://your-1c-server:port/your-base
ONEC_USERNAME=your_username
ONEC_PASSWORD=your_password
ONEC_TIMEOUT=30

# AmoCRM интеграция (если нужна)
AMOCRM_CLIENT_ID=
AMOCRM_CLIENT_SECRET=
AMOCRM_REDIRECT_URI=
AMOCRM_BASE_URL=

# Логирование
LOG_LEVEL=INFO

# Окружение
GO_ENV=development
